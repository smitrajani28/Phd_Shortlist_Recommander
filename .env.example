# ─────────────────────────────────────────────
# PhD Shortlist Builder — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# LLM (used by WhyMatchGenerator)
# Set OPENAI_API_KEY to enable GPT-4o-mini; leave blank to use deterministic fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# External academic APIs
SEMANTIC_SCHOLAR_API_KEY=           # optional; increases rate limit
OPENALEX_EMAIL=your@email.com       # polite pool identifier

# Pipeline behaviour
MAX_RECOMMENDATIONS=100             # range: 50–200
MIN_RECENT_PAPERS=2
RECENCY_YEARS=5

# Faculty scraper — comma-separated URLs
FACULTY_URLS=[]                 # JSON array, e.g. ["https://cs.mit.edu/faculty"]

# Logging
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FILE=                           # leave blank to log to stdout only
