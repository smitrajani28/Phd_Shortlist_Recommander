# ─────────────────────────────────────────────
# PhD Shortlist Builder — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# LLM (used by WhyMatchGenerator)
# Provider: 'gemini' (default, free tier) or 'openai'
LLM_PROVIDER=gemini

# Gemini — free API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI — only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# External academic APIs
SEMANTIC_SCHOLAR_API_KEY=           # optional; increases rate limit
OPENALEX_EMAIL=your@email.com       # polite pool identifier

# Pipeline behaviour
MAX_RECOMMENDATIONS=100             # range: 50–200
MIN_RECENT_PAPERS=2
RECENCY_YEARS=5

# Faculty scraper — comma-separated URLs
FACULTY_URLS=[]                 # JSON array, e.g. ["https://cs.mit.edu/faculty"]

# Logging
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FILE=                           # leave blank to log to stdout only
